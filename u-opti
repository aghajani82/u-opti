#!/bin/bash

# U-OPTI requires root privileges.
if [ "$EUID" -ne 0 ]; then
    if ! command -v sudo >/dev/null 2>&1; then
        echo "Error: Root privileges are required, but sudo is not installed."
        exit 1
    fi

    exec sudo -E "$0" "$@"
fi

INSTALL_PATH="/usr/local/bin/u-opti"
LIB_PATH="/usr/local/lib/u-opti"
MODULES_PATH="$LIB_PATH/modules"
VERSION_FILE="$LIB_PATH/VERSION"

# Interrupted update recovery MUST run before sourcing any module. The
# transaction journal bundles its original recovery code, independent of
# the concurrently upgraded module file. Unknown/tampered state HOLDS.
if [ -e "$LIB_PATH/.uopti-update-pending" ] || [ -L "$LIB_PATH/.uopti-update-pending" ]; then
    RECOVERY_SCRIPT="$LIB_PATH/.uopti-update-pending/rescue.py"
    if [ ! -f "$RECOVERY_SCRIPT" ] || [ -L "$RECOVERY_SCRIPT" ] || ! command -v python3 >/dev/null 2>&1; then
        echo "HOLD: Interrupted U-OPTI update needs manual recovery; journal unreadable." >&2
        exit 1
    fi
    if ! python3 -B "$RECOVERY_SCRIPT" recover; then
        echo "HOLD: Could not safely recover interrupted update; no U-OPTI modules loaded." >&2
        exit 1
    fi
    echo "Previous U-OPTI version restored after interrupted update."
    # This shell is still executing the NEW program text loaded before
    # rollback. Re-exec the restored OLD binary instead of mixing new
    # functions with old modules.
    exec "$INSTALL_PATH" "$@"
    echo "HOLD: Could not relaunch restored U-OPTI executable." >&2
    exit 1
fi

# Explicit environment selection takes priority; otherwise persist install source.
BRANCH="${U_OPTI_BRANCH:-}"
if [ -z "$BRANCH" ]; then
    if [ -f "$LIB_PATH/INSTALL_REF" ]; then
        BRANCH="$(head -n 1 "$LIB_PATH/INSTALL_REF")"
    else
        BRANCH=main
    fi
fi
if [[ ! "$BRANCH" =~ ^[A-Za-z0-9._/-]+$ ]] || [[ "$BRANCH" == *".."* ]] || [[ "$BRANCH" == /* ]]; then
    echo "ERROR: Invalid persisted U-OPTI source branch/ref: $BRANCH" >&2
    exit 1
fi
# Keep every lazily loaded wizard/helper on the same installed source ref.
export U_OPTI_BRANCH="$BRANCH"
BASE_URL="https://raw.githubusercontent.com/aghajani82/u-opti/$BRANCH"
RAW_BASE_URL="https://raw.githubusercontent.com/aghajani82/u-opti/$BRANCH"

if [ -f "$VERSION_FILE" ]; then
    VERSION=$(tr -d '[:space:]' < "$VERSION_FILE")
fi

if [ -z "$VERSION" ]; then
    VERSION="0.12.0"
fi

# Non-interactive CLI metadata must return before loading feature modules or
# entering any menu. This keeps scripted verification from being consumed as
# menu input after a fresh install.
case "${1:-}" in
    --version|-V|version)
        printf '%s\n' "$VERSION"
        exit 0
        ;;
esac

# BEGIN: KH dynamic XHTTP guard legacy-updater compatibility
# The previous fixed-file updater cannot download this newly introduced file.
# Recover only this inert guard from the immutable installed source revision.
# No Nginx config, tunnel or container is changed by this compatibility step.
u_opti_ensure_kh_xhttp_guard_bundle() {
    local name="docker-3xui-xhttp-guard.py"
    local expected_blob="470ac5f9f9795a1d79f7f78c04895c71d4c632b5"
    local target="$MODULES_PATH/$name"
    local temp_dir=""
    if [ -L "$target" ]; then return 1; fi
    if [ -f "$target" ]; then
        python3 -B - "$target" "$expected_blob" <<'PY_KH_GUARD_HASH'
import ast, hashlib, pathlib, sys
data = pathlib.Path(sys.argv[1]).read_bytes()
if hashlib.sha1(b"blob " + str(len(data)).encode() + b"\0" + data).hexdigest() != sys.argv[2]:
    raise SystemExit(1)
ast.parse(data.decode("utf-8"))
PY_KH_GUARD_HASH
        return $?
    fi
    [ ! -e "$target" ] || return 1
    [[ "$BRANCH" =~ ^[a-f0-9]{40}$ ]] || return 1
    [ -d "$MODULES_PATH" ] && [ ! -L "$MODULES_PATH" ] || return 1
    [ "$(stat -c %u "$MODULES_PATH")" = 0 ] || return 1
    command -v python3 >/dev/null 2>&1 || return 1
    command -v curl >/dev/null 2>&1 || return 1
    temp_dir="$(mktemp -d)" || return 1
    if ! curl -fsSL --retry 3 --max-time 30 "$BASE_URL/modules/$name" -o "$temp_dir/$name" ||
       ! python3 -B - "$temp_dir/$name" "$expected_blob" <<'PY_KH_GUARD_VERIFY'
import ast, hashlib, pathlib, sys
data = pathlib.Path(sys.argv[1]).read_bytes()
if len(data) > 65536 or hashlib.sha1(b"blob " + str(len(data)).encode() + b"\0" + data).hexdigest() != sys.argv[2]:
    raise SystemExit(1)
ast.parse(data.decode("utf-8"))
PY_KH_GUARD_VERIFY
    then
        rm -rf -- "$temp_dir"
        return 1
    fi
    if [ -e "$target" ] || [ -L "$target" ] ||
       ! install -m 0644 -- "$temp_dir/$name" "$target"; then
        rm -rf -- "$temp_dir"
        return 1
    fi
    rm -rf -- "$temp_dir"
    echo "KH dynamic XHTTP guard module verified and installed (no live changes)."
    return 0
}
if ! u_opti_ensure_kh_xhttp_guard_bundle; then
    echo "WARNING: KH XHTTP guard bundle unavailable; secured route sync remains HOLD." >&2
fi
# END: KH dynamic XHTTP guard legacy-updater compatibility

source "$LIB_PATH/common.sh"
source "$MODULES_PATH/system.sh"
source "$MODULES_PATH/time.sh"
source "$MODULES_PATH/swap.sh"
source "$MODULES_PATH/bbr.sh"
source "$MODULES_PATH/storage.sh"
source "$MODULES_PATH/ssh.sh"
source "$MODULES_PATH/ssh-access.sh"
source "$MODULES_PATH/firewall.sh"
source "$MODULES_PATH/fail2ban.sh"
source "$MODULES_PATH/xui-pro.sh"
source "$MODULES_PATH/certificate.sh"
source "$MODULES_PATH/backup.sh"
source "$MODULES_PATH/docker.sh"
# BEGIN: U-OPTI legacy Standard FRP bundle upgrade compatibility
# v0.15.2's fixed-file updater does not know about these two new modules.
# After it installs the newer u-opti and restarts, provision the validated pair.
# Existing valid modules are not modified; running services are never restarted.
u_opti_ensure_standard_frp_bundle() {
    local file marker tmp_dir stage_dir
    local complete=true
    for file in smite-frp-wizard.sh smite-frp-xhttp.sh smite-frp-xhttp-paths.py smite-frp-rc2-guided-publish.py; do
        if [ ! -s "$MODULES_PATH/$file" ] || {
            case "$file" in
                *.py) ! python3 -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' "$MODULES_PATH/$file" >/dev/null 2>&1 ;;
                *) ! bash -n "$MODULES_PATH/$file" >/dev/null 2>&1 ;;
            esac
        }; then
            complete=false
            break
        fi
    done
    if [ "$complete" = true ] &&
       grep -Fq 'smite_frp_wizard_menu()' "$MODULES_PATH/smite-frp-wizard.sh" &&
       grep -Fq 'smite_frp_xhttp_sync()' "$MODULES_PATH/smite-frp-xhttp.sh" &&
       grep -Fq 'def render(' "$MODULES_PATH/smite-frp-xhttp-paths.py" &&
       grep -Fq 'def inspection(' "$MODULES_PATH/smite-frp-rc2-guided-publish.py"; then
        return 0
    fi

    command -v curl >/dev/null 2>&1 || return 1
    tmp_dir="$(mktemp -d)" || return 1
    for file in smite-frp-wizard.sh smite-frp-xhttp.sh smite-frp-xhttp-paths.py smite-frp-rc2-guided-publish.py; do
        if ! curl -fsSL --retry 3 \
                "$BASE_URL/modules/$file?cb=$(date +%s%N)" -o "$tmp_dir/$file" ||
           [ ! -s "$tmp_dir/$file" ] ||
           { case "$file" in
                 *.py) ! python3 -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' "$tmp_dir/$file" >/dev/null 2>&1 ;;
                 *) ! bash -n "$tmp_dir/$file" >/dev/null 2>&1 ;;
             esac; }; then
            rm -rf "$tmp_dir"
            return 1
        fi
    done
    if ! grep -Fq 'smite_frp_wizard_menu()' "$tmp_dir/smite-frp-wizard.sh" ||
       ! grep -Fq 'smite_frp_xhttp_sync()' "$tmp_dir/smite-frp-xhttp.sh" ||
       ! grep -Fq 'def render(' "$tmp_dir/smite-frp-xhttp-paths.py" ||
       ! grep -Fq 'def inspection(' "$tmp_dir/smite-frp-rc2-guided-publish.py"; then
        rm -rf "$tmp_dir"
        return 1
    fi
    stage_dir="$(mktemp -d "$MODULES_PATH/.frp-upgrade-XXXXXXXX")" || {
        rm -rf "$tmp_dir"
        return 1
    }
    for file in smite-frp-wizard.sh smite-frp-xhttp.sh smite-frp-xhttp-paths.py smite-frp-rc2-guided-publish.py; do
        if ! install -m 0755 "$tmp_dir/$file" "$stage_dir/$file"; then
            rm -rf "$tmp_dir" "$stage_dir"
            return 1
        fi
    done
    for file in smite-frp-wizard.sh smite-frp-xhttp.sh smite-frp-xhttp-paths.py smite-frp-rc2-guided-publish.py; do
        if ! mv -f "$stage_dir/$file" "$MODULES_PATH/$file"; then
            rm -rf "$tmp_dir" "$stage_dir"
            return 1
        fi
    done
    rm -rf "$tmp_dir" "$stage_dir"
    return 0
}

if ! u_opti_ensure_standard_frp_bundle; then
    echo "WARNING: Standard FRP modules could not be prepared; retry Update U-OPTI when online." >&2
fi
# END: U-OPTI legacy Standard FRP bundle upgrade compatibility


# BEGIN: U-OPTI signed Field Trial bundle upgrade compatibility
# A previous fixed-file updater cannot know module names introduced by the
# new u-opti executable it is currently installing. On the next exec, repair
# ONLY this inert verifier+manifest pair from the exact immutable INSTALL_REF.
# No Docker image is pulled and no Smite service is started here.
u_opti_ensure_signed_field_trial_bundle() {
    local verifier="smite-registry-pair-admission.py"
    local manifest="smite-field-trial-candidate.json"
    local expected_manifest_sha="d364bd48ee12288ae67dc0e6c15fcc9d15e43ae73cf82c3c33da242890b4f65f"
    local tmp_dir stage_dir actual_manifest complete=true

    if [ ! -s "$MODULES_PATH/$verifier" ] ||
       [ -L "$MODULES_PATH/$verifier" ] ||
       ! python3 -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' "$MODULES_PATH/$verifier" >/dev/null 2>&1 ||
       ! grep -Fq 'PANEL_NODE_IMMUTABLE_DIGEST_SIGNATURES=VERIFIED' "$MODULES_PATH/$verifier"; then
        complete=false
    fi

    if [ ! -s "$MODULES_PATH/$manifest" ] || [ -L "$MODULES_PATH/$manifest" ]; then
        complete=false
    else
        actual_manifest="$(sha256sum "$MODULES_PATH/$manifest" | awk '{print $1}')" || complete=false
        [ "$actual_manifest" = "$expected_manifest_sha" ] || complete=false
    fi

    [ "$complete" = true ] && return 0

    if [[ ! "$BRANCH" =~ ^[a-f0-9]{40}$ ]]; then
        echo "HOLD: Signed Field Trial bootstrap requires an immutable 40-char INSTALL_REF." >&2
        return 1
    fi
    command -v curl >/dev/null 2>&1 || return 1
    command -v python3 >/dev/null 2>&1 || return 1
    command -v sha256sum >/dev/null 2>&1 || return 1

    tmp_dir="$(mktemp -d)" || return 1
    if ! curl -fsSL --retry 3             "$BASE_URL/modules/$verifier?cb=$(date +%s%N)" -o "$tmp_dir/$verifier" ||
       ! curl -fsSL --retry 3             "$BASE_URL/modules/$manifest?cb=$(date +%s%N)" -o "$tmp_dir/$manifest"; then
        rm -rf "$tmp_dir"
        return 1
    fi

    if [ ! -s "$tmp_dir/$verifier" ] ||
       ! python3 -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' "$tmp_dir/$verifier" >/dev/null 2>&1 ||
       ! grep -Fq 'PANEL_NODE_IMMUTABLE_DIGEST_SIGNATURES=VERIFIED' "$tmp_dir/$verifier" ||
       [ "$(sha256sum "$tmp_dir/$manifest" | awk '{print $1}')" != "$expected_manifest_sha" ]; then
        rm -rf "$tmp_dir"
        return 1
    fi

    stage_dir="$(mktemp -d "$MODULES_PATH/.signed-field-trial-XXXXXXXX")" || {
        rm -rf "$tmp_dir"
        return 1
    }
    install -m 0755 "$tmp_dir/$verifier" "$stage_dir/$verifier" &&
    install -m 0644 "$tmp_dir/$manifest" "$stage_dir/$manifest" || {
        rm -rf "$tmp_dir" "$stage_dir"
        return 1
    }

    mv -f "$stage_dir/$verifier" "$MODULES_PATH/$verifier" &&
    mv -f "$stage_dir/$manifest" "$MODULES_PATH/$manifest" || {
        rm -rf "$tmp_dir" "$stage_dir"
        return 1
    }

    rm -rf "$tmp_dir" "$stage_dir"

    python3 -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' "$MODULES_PATH/$verifier" >/dev/null 2>&1 &&
    [ "$(sha256sum "$MODULES_PATH/$manifest" | awk '{print $1}')" = "$expected_manifest_sha" ]
}

if ! u_opti_ensure_signed_field_trial_bundle; then
    echo "WARNING: Signed Smite Field Trial verifier bundle is incomplete; retry Update U-OPTI from an exact SHA." >&2
fi
# END: U-OPTI signed Field Trial bundle upgrade compatibility

# FRP Wizard extends the Smite submenu only; original Private Wizard stays untouched.
if [ -f "$MODULES_PATH/smite-frp-wizard.sh" ]; then
    source "$MODULES_PATH/smite-frp-wizard.sh"
fi
# Additive Backhaul prepare-only menu, preserving original FRP/Private choices.
if [ -s "$MODULES_PATH/smite-backhaul-management.sh" ] &&
   [ -s "$MODULES_PATH/smite-backhaul-standard.sh" ] &&
   [ -s "$MODULES_PATH/smite-backhaul-spec.py" ] &&
   [ -s "$MODULES_PATH/smite-backhaul-node-patch.py" ] &&
   [ -s "$MODULES_PATH/smite-backhaul-panel-patch.py" ]; then
    source "$MODULES_PATH/smite-backhaul-management.sh"
fi
if [ -s "$MODULES_PATH/smite-clean-ir-resume.sh" ]; then
    source "$MODULES_PATH/smite-clean-ir-resume.sh"
fi
source "$MODULES_PATH/docker-3xui-instance.sh"
source "$MODULES_PATH/docker-3xui-certificate-multi.sh"
source "$MODULES_PATH/docker-3xui-nginx.sh"

# ---------------------------------------------------------------------------
# Direct menu invocation
# ---------------------------------------------------------------------------
# When U-OPTI is re-launched internally (e.g. after a 3x-UI panel install),
# the caller can request a specific submenu directly. This avoids showing
# the main menu again and keeps the user in the same workflow.
#
# Usage:
#   u-opti --menu docker
# ---------------------------------------------------------------------------
if [ "${1:-}" = "--menu" ] && [ -n "${2:-}" ]; then
    case "$2" in
        docker)
            docker_management_menu
            # Fall through to the main menu loop below.
            # This way pressing 0 in Docker Management returns to the
            # main menu instead of exiting U-OPTI entirely.
            ;;
        *)
            echo "U-OPTI: Unknown menu target: $2" >&2
            exit 1
            ;;
    esac
fi

# Opt-in standalone preview. No existing Docker/Smite wizard is replaced.
if [ "${1:-}" = "--smite-pairing" ]; then
    pairing_wizard="$MODULES_PATH/smite-node-pairing-wizard.sh"
    if [ ! -s "$pairing_wizard" ] || ! bash -n "$pairing_wizard"; then
        echo "HOLD: Smite pairing preview helper is not available." >&2
        exit 2
    fi
    source "$pairing_wizard"
    smite_node_pairing_menu
    exit $?
fi

# Explicit offline Clean-RC installer entry. Never fall back to Stable or the
# legacy Private Network wizard when the paired preview inputs are incomplete.
if [ "${1:-}" = "--smite-clean-rc" ]; then
    bundle_helper="$MODULES_PATH/smite-clean-image-pair.py"
    if [ -z "${SMITE_RC_BUNDLE_DIR:-}" ] ||
       [ -z "${SMITE_RC_SOURCE_SHA:-}" ] ||
       [ -z "${SMITE_RC_MANIFEST_SHA256:-}" ]; then
        echo "HOLD: Set SMITE_RC_BUNDLE_DIR, SMITE_RC_SOURCE_SHA and SMITE_RC_MANIFEST_SHA256." >&2
        exit 2
    fi
    if [[ ! "$SMITE_RC_SOURCE_SHA" =~ ^[0-9a-f]{40}$ ]] ||
       [[ ! "$SMITE_RC_MANIFEST_SHA256" =~ ^[0-9a-f]{64}$ ]]; then
        echo "HOLD: Clean-RC source/manifest hashes have invalid format." >&2
        exit 2
    fi
    if [ ! -d "$SMITE_RC_BUNDLE_DIR" ] || [ -L "$SMITE_RC_BUNDLE_DIR" ] ||
       [ ! -s "$bundle_helper" ] || [ -L "$bundle_helper" ]; then
        echo "HOLD: Clean-RC bundle directory or verifier is missing/unsafe." >&2
        exit 2
    fi
    for input in stage15-images.json smite-panel-stage15.docker.tar.gz smite-node-stage15.docker.tar.gz; do
        if [ ! -f "$SMITE_RC_BUNDLE_DIR/$input" ] || [ -L "$SMITE_RC_BUNDLE_DIR/$input" ]; then
            echo "HOLD: Clean-RC bundle input is missing/unsafe: $input" >&2
            exit 2
        fi
    done
    python3 -B "$bundle_helper" \
        --folder "$SMITE_RC_BUNDLE_DIR" \
        --source-sha "$SMITE_RC_SOURCE_SHA" \
        --manifest-sha256 "$SMITE_RC_MANIFEST_SHA256" || exit 2
    SMITE_INSTALL_PROFILE=clean-rc
    export SMITE_INSTALL_PROFILE

    # Prepare gateway packages only for a fresh IR install. KH installs and
    # existing partial IR installs use their separate, guided paths.
    SMITE_RC_PREFLIGHT_PANEL_COMPOSE="${SMITE_PANEL_DIR:-/opt/smite}/docker-compose.yml"
    SMITE_RC_PREFLIGHT_NODE_COMPOSE="${SMITE_NODE_DIR:-/opt/smite-node}/docker-compose.yml"
    if [ "$(hostname -s 2>/dev/null | tr '[:upper:]' '[:lower:]')" = "ir" ] &&
       ! docker inspect smite-panel >/dev/null 2>&1 &&
       ! docker inspect smite-node >/dev/null 2>&1 &&
       [ ! -e "$SMITE_RC_PREFLIGHT_PANEL_COMPOSE" ] &&
       [ ! -L "$SMITE_RC_PREFLIGHT_PANEL_COMPOSE" ] &&
       [ ! -e "$SMITE_RC_PREFLIGHT_NODE_COMPOSE" ] &&
       [ ! -L "$SMITE_RC_PREFLIGHT_NODE_COMPOSE" ]; then
        SMITE_RC_PREFLIGHT_MODULE="$MODULES_PATH/smite-clean-rc-preflight.sh"
        if [ ! -s "$SMITE_RC_PREFLIGHT_MODULE" ] || [ -L "$SMITE_RC_PREFLIGHT_MODULE" ]; then
            echo "HOLD: Clean-RC Nginx package preflight module is missing or unsafe. Run Update U-OPTI again." >&2
            exit 2
        fi
        # shellcheck source=/dev/null
        source "$SMITE_RC_PREFLIGHT_MODULE" || exit 2
        smite_clean_rc_prepare_gateway_packages || {
            echo "HOLD: Clean-RC Nginx prerequisite is not ready; no Smite install was started." >&2
            exit 2
        }
    fi

    if ! declare -F show_smite_install_menu >/dev/null 2>&1; then
        echo "HOLD: Smite Install/Lifecycle menu is unavailable." >&2
        exit 2
    fi
    echo "CLEAN_RC_INSTALL_ENTRY=EXPLICIT_PREVIEW"
    echo "Pairing remains disabled until the separate Signed Pairing workflow."
    show_smite_install_menu
    exit $?
fi

while true; do
    clear

    echo "======================================"
    echo "              U-OPTI"
    echo "       Ubuntu Server Optimizer"
    echo "              v$VERSION"
    echo "======================================"
    echo
    echo "1) Update Server"
    echo "2) System Optimization"
    echo "3) Server Security"
    echo "4) X-UI PRO Management"
    echo "5) Certificate Management"
    echo "6) Backup & Restore"
    echo "7) Docker Management"
    echo "8) Update U-OPTI"
    echo "9) Uninstall U-OPTI"
    echo
    echo "0) Exit"
    echo

    IFS= read -r -p "Please enter your selection [0-9]: " choice

    # Trim leading/trailing whitespace (including a Windows CR) so Bitvise
    # paste artifacts cannot turn a valid 0 into an invalid selection.
    choice="${choice#"${choice%%[![:space:]]*}"}"
    choice="${choice%"${choice##*[![:space:]]}"}"

    case "$choice" in

        1)
            clear

            echo "======================================"
            echo "           Updating Server"
            echo "======================================"
            echo

            apt update && apt upgrade -y

            echo
            echo "--------------------------------------"
            echo "Server update completed."
            echo

            read -rp "Press Enter to return to menu..."
            ;;

        2)
            while true; do
                clear

                echo "======================================"
                echo "        System Optimization"
                echo "======================================"
                echo
                echo "1) System Information"
                echo "2) Time & Date"
                echo "3) Swap Management"
                echo "4) BBR Management"
                echo "5) Storage Management"
                echo "6) Hostname Management"
                echo
                echo "0) Back"
                echo

                read -rp "Please enter your selection [0-6]: " opt_choice
                opt_choice="${opt_choice#"${opt_choice%%[![:space:]]*}"}"
                opt_choice="${opt_choice%"${opt_choice##*[![:space:]]}"}"

                case "$opt_choice" in

                    1)
                        show_system_information
                        ;;

                    2)
                        show_time_menu
                        ;;

                    3)
                        show_swap_menu
                        ;;

                    4)
                        show_bbr_menu
                        ;;

                    5)
                        show_storage_menu
                        ;;

                    6)
                        show_hostname_menu
                        ;;

                    0)
                        break
                        ;;

                    *)
                        echo
                        echo "Invalid selection!"
