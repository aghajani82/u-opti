                        ;;
                esac
            done
            ;;

        3)
            while true; do
                clear

                echo "======================================"
                echo "         Server Security"
                echo "======================================"
                echo
                echo "1) SSH Security"
                echo "2) Firewall Management"
                echo "3) Fail2Ban"
                echo
                echo "0) Back"
                echo

                read -rp "Please enter your selection [0-3]: " security_choice
                security_choice="${security_choice#"${security_choice%%[![:space:]]*}"}"
                security_choice="${security_choice%"${security_choice##*[![:space:]]}"}"

                case "$security_choice" in

                    1)
                        show_ssh_menu
                        ;;

                    2)
                        show_firewall_menu
                        ;;

                    3)
                        show_fail2ban_menu
                        ;;

                    0)
                        break
                        ;;

                    *)
                        echo
                        echo "Invalid selection!"
                        sleep 2
                        ;;
                esac
            done
            ;;

        4)
            show_xui_pro_menu
            ;;

        5)
            show_certificate_menu
            ;;

        6)
            show_backup_menu
            ;;

        7)
            docker_management_menu
            ;;

        8)
            clear

            echo "======================================"
            echo "            Update U-OPTI"
            echo "======================================"
            echo

            if ! command -v curl >/dev/null 2>&1; then
                echo "Error: curl is not installed."
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            TEMP_DIR=$(mktemp -d)

# BEGIN: U-OPTI immutable per-operation source pin
# Resolve once; never download a mixture of mutable branch revisions.
u_opti_resolve_source_sha() {
    local ref="$1" response
    if [[ ! "$ref" =~ ^[A-Za-z0-9._/-]+$ ]] ||
       [[ "$ref" == *".."* ]] || [[ "$ref" == /* ]]; then
        return 1
    fi
    response="$(curl -fsSL --retry 2 --connect-timeout 10 --max-time 30 \
        -H 'Accept: application/vnd.github+json' \
        -H 'X-GitHub-Api-Version: 2022-11-28' \
        "https://api.github.com/repos/aghajani82/u-opti/commits/$ref")" || return 1
    printf '%s' "$response" | python3 -c '
import json
import re
import sys
data = json.load(sys.stdin)
sha = data.get("sha") if isinstance(data, dict) else None
if not isinstance(sha, str) or re.fullmatch(r"[0-9a-f]{40}", sha) is None:
    sys.exit("UNTRUSTED_SOURCE_SHA")
print(sha)
'
}
# END: U-OPTI immutable per-operation source pin

            download_repo_file() {
                local REPO_PATH="$1"
                local DESTINATION="$2"

                local CACHE_BUST
                CACHE_BUST="$(date +%s%N)"

                curl -fsSL --retry 3 \
                    -H "Accept: application/vnd.github.raw+json" \
                    "${UPDATE_RAW_BASE_URL}/${REPO_PATH}?cb=${CACHE_BUST}" \
                    -o "$DESTINATION"
            }

            cleanup_update_temp() {
                rm -rf "$TEMP_DIR"
            }

            update_failed_restore() {
                local RESTORE_OK=true
