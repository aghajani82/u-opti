                ["smite-backhaul-sidecar-nginx-plan.py"]="$TEMP_DIR/smite-backhaul-sidecar-nginx-plan.py"
                ["smite-backhaul-standard.sh"]="$TEMP_DIR/smite-backhaul-standard.sh"
                ["smite-backhaul-spec.py"]="$TEMP_DIR/smite-backhaul-spec.py"
                ["smite-backhaul-node-patch.py"]="$TEMP_DIR/smite-backhaul-node-patch.py"
