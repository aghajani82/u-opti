#!/bin/bash

# U-OPTI requires root privileges.
if [ "$EUID" -ne 0 ]; then
    if ! command -v sudo >/dev/null 2>&1; then
        echo "Error: Root privileges are required, but sudo is not installed."
        exit 1
    fi
    exec sudo -E "$0" "$@"
fi

INSTALL_PATH="/usr/local/bin/u-opti"
LIB_PATH="/usr/local/lib/u-opti"
MODULES_PATH="$LIB_PATH/modules"
VERSION_FILE="$LIB_PATH/VERSION"

BRANCH="main"
BASE_URL="https://raw.githubusercontent.com/aghajani82/u-opti/$BRANCH"

if [ -f "$VERSION_FILE" ]; then
    VERSION=$(tr -d '[:space:]' < "$VERSION_FILE")
fi

if [ -z "$VERSION" ]; then
    VERSION="0.10.0"
fi

source "$LIB_PATH/common.sh"
source "$MODULES_PATH/system.sh"
source "$MODULES_PATH/time.sh"
source "$MODULES_PATH/swap.sh"
source "$MODULES_PATH/bbr.sh"
source "$MODULES_PATH/storage.sh"
source "$MODULES_PATH/ssh.sh"
source "$MODULES_PATH/ssh-access.sh"
source "$MODULES_PATH/firewall.sh"
source "$MODULES_PATH/xui-pro.sh"
source "$MODULES_PATH/certificate.sh"

while true; do
    clear

    echo "======================================"
    echo "              U-OPTI"
    echo "       Ubuntu Server Optimizer"
    echo "              v$VERSION"
    echo "======================================"
    echo
    echo "1) Update Server"
    echo "2) System Optimization"
    echo "3) SSH Management"
    echo "4) Firewall Management"
    echo "5) X-UI PRO Management"
    echo "6) Certificate Management"
    echo "7) Update U-OPTI"
    echo "8) Uninstall U-OPTI"
    echo
    echo "0) Exit"
    echo

    read -rp "Please enter your selection [0-8]: " choice

    case "$choice" in

        1)
            clear

            echo "======================================"
            echo "           Updating Server"
            echo "======================================"
            echo

            apt update && apt upgrade -y

            echo
            echo "--------------------------------------"
            echo "Server update completed."
            echo

            read -rp "Press Enter to return to menu..."
            ;;

        2)
            while true; do
                clear

                echo "======================================"
                echo "        System Optimization"
                echo "======================================"
                echo
                echo "1) System Information"
                echo "2) Time & Date"
                echo "3) Swap Management"
                echo "4) BBR Management"
                echo "5) Storage Management"
                echo
                echo "0) Back"
                echo

                read -rp "Please enter your selection [0-5]: " opt_choice

                case "$opt_choice" in

                    1)
                        show_system_information
                        ;;

                    2)
                        show_time_menu
                        ;;

                    3)
                        show_swap_menu
                        ;;

                    4)
                        show_bbr_menu
                        ;;

                    5)
                        show_storage_menu
                        ;;

                    0)
                        break
                        ;;

                    *)
                        echo
                        echo "Invalid selection!"
                        sleep 2
                        ;;
                esac
            done
            ;;

        3)
            show_ssh_menu
            ;;

        4)
            show_firewall_menu
            ;;

        5)
            show_xui_pro_menu
            ;;

        6)
            show_certificate_menu
            ;;

        7)
            clear

            echo "======================================"
            echo "            Update U-OPTI"
            echo "======================================"
            echo

            if ! command -v curl >/dev/null 2>&1; then
                echo "Error: curl is not installed."
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            TEMP_DIR=$(mktemp -d)

            echo "Preparing update..."
            echo

            echo "Downloading VERSION..."

            if ! curl -fsSL "$BASE_URL/VERSION" -o "$TEMP_DIR/VERSION"; then
                echo
                echo "Failed to download VERSION."
                rm -rf "$TEMP_DIR"
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            REMOTE_VERSION=$(tr -d '[:space:]' < "$TEMP_DIR/VERSION")

            if [ -z "$REMOTE_VERSION" ]; then
                echo
                echo "Remote version could not be determined."
                rm -rf "$TEMP_DIR"
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo "Current Version : $VERSION"
            echo "Remote Version  : $REMOTE_VERSION"
            echo

            echo "Downloading U-OPTI..."

            if ! curl -fsSL "$BASE_URL/u-opti" -o "$TEMP_DIR/u-opti"; then
                echo
                echo "Failed to download u-opti."
                rm -rf "$TEMP_DIR"
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo "Downloading common library..."

            if ! curl -fsSL "$BASE_URL/lib/common.sh" -o "$TEMP_DIR/common.sh"; then
                echo
                echo "Failed to download common.sh."
                rm -rf "$TEMP_DIR"
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo "Downloading System Information module..."

            if ! curl -fsSL "$BASE_URL/modules/system.sh" -o "$TEMP_DIR/system.sh"; then
                echo
                echo "Failed to download system.sh."
                rm -rf "$TEMP_DIR"
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo "Downloading Time & Date module..."

            if ! curl -fsSL "$BASE_URL/modules/time.sh" -o "$TEMP_DIR/time.sh"; then
                echo
                echo "Failed to download time.sh."
                rm -rf "$TEMP_DIR"
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo "Downloading Swap Management module..."

            if ! curl -fsSL "$BASE_URL/modules/swap.sh" -o "$TEMP_DIR/swap.sh"; then
                echo
                echo "Failed to download swap.sh."
                rm -rf "$TEMP_DIR"
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo "Downloading BBR Management module..."

            if ! curl -fsSL "$BASE_URL/modules/bbr.sh" -o "$TEMP_DIR/bbr.sh"; then
                echo
                echo "Failed to download bbr.sh."
                rm -rf "$TEMP_DIR"
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo "Downloading Storage Management module..."

            if ! curl -fsSL "$BASE_URL/modules/storage.sh" -o "$TEMP_DIR/storage.sh"; then
                echo
                echo "Failed to download storage.sh."
                rm -rf "$TEMP_DIR"
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo "Downloading SSH Management module..."

            if ! curl -fsSL "$BASE_URL/modules/ssh.sh" -o "$TEMP_DIR/ssh.sh"; then
                echo
                echo "Failed to download ssh.sh."
                rm -rf "$TEMP_DIR"
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo "Downloading Firewall Management module..."

            if ! curl -fsSL "$BASE_URL/modules/firewall.sh" -o "$TEMP_DIR/firewall.sh"; then
                echo
                echo "Failed to download firewall.sh."
                rm -rf "$TEMP_DIR"
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo "Downloading X-UI PRO Management module..."

            if ! curl -fsSL "$BASE_URL/modules/xui-pro.sh" -o "$TEMP_DIR/xui-pro.sh"; then
                echo
                echo "Failed to download xui-pro.sh."
                rm -rf "$TEMP_DIR"
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo "Downloading Certificate Management module..."

            if ! curl -fsSL "$BASE_URL/modules/certificate.sh" -o "$TEMP_DIR/certificate.sh"; then
                echo
                echo "Failed to download certificate.sh."
                rm -rf "$TEMP_DIR"
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo
            echo "Checking downloaded files..."

            REQUIRED_FILES=(
                "$TEMP_DIR/VERSION"
                "$TEMP_DIR/u-opti"
                "$TEMP_DIR/common.sh"
                "$TEMP_DIR/system.sh"
                "$TEMP_DIR/time.sh"
                "$TEMP_DIR/swap.sh"
                "$TEMP_DIR/bbr.sh"
                "$TEMP_DIR/storage.sh"
                "$TEMP_DIR/ssh.sh"
                "$TEMP_DIR/firewall.sh"
                "$TEMP_DIR/xui-pro.sh"
                "$TEMP_DIR/certificate.sh"
            )

            UPDATE_FILES_OK=true

            for FILE in "${REQUIRED_FILES[@]}"; do
                if [ ! -s "$FILE" ]; then
                    echo
                    echo "Missing or empty file:"
                    echo "$FILE"
                    UPDATE_FILES_OK=false
                fi
            done

            if [ "$UPDATE_FILES_OK" != "true" ]; then
                echo
                echo "Update cancelled."
                echo "The installed version was not changed."
                rm -rf "$TEMP_DIR"
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo "All required files are present."

            echo
            echo "Checking Bash syntax..."

            if ! bash -n "$TEMP_DIR/u-opti" || \
               ! bash -n "$TEMP_DIR/common.sh" || \
               ! bash -n "$TEMP_DIR/system.sh" || \
               ! bash -n "$TEMP_DIR/time.sh" || \
               ! bash -n "$TEMP_DIR/swap.sh" || \
               ! bash -n "$TEMP_DIR/bbr.sh" || \
               ! bash -n "$TEMP_DIR/storage.sh" || \
               ! bash -n "$TEMP_DIR/ssh.sh" || \
               ! bash -n "$TEMP_DIR/firewall.sh" || \
               ! bash -n "$TEMP_DIR/xui-pro.sh" || \
               ! bash -n "$TEMP_DIR/certificate.sh"; then

                echo
                echo "Bash syntax check failed."
                echo "Update cancelled."
                rm -rf "$TEMP_DIR"
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo "Bash syntax check passed."

            echo
            echo "Creating backup of current installation..."

            BACKUP_DIR=$(mktemp -d)

            cp -f "$INSTALL_PATH" "$BACKUP_DIR/u-opti" 2>/dev/null || true
            cp -f "$LIB_PATH/common.sh" "$BACKUP_DIR/common.sh" 2>/dev/null || true
            cp -f "$LIB_PATH/VERSION" "$BACKUP_DIR/VERSION" 2>/dev/null || true

            cp -f "$MODULES_PATH/system.sh" "$BACKUP_DIR/system.sh" 2>/dev/null || true
            cp -f "$MODULES_PATH/time.sh" "$BACKUP_DIR/time.sh" 2>/dev/null || true
            cp -f "$MODULES_PATH/swap.sh" "$BACKUP_DIR/swap.sh" 2>/dev/null || true
            cp -f "$MODULES_PATH/bbr.sh" "$BACKUP_DIR/bbr.sh" 2>/dev/null || true
            cp -f "$MODULES_PATH/storage.sh" "$BACKUP_DIR/storage.sh" 2>/dev/null || true
            cp -f "$MODULES_PATH/ssh.sh" "$BACKUP_DIR/ssh.sh" 2>/dev/null || true
            cp -f "$MODULES_PATH/firewall.sh" "$BACKUP_DIR/firewall.sh" 2>/dev/null || true
            cp -f "$MODULES_PATH/xui-pro.sh" "$BACKUP_DIR/xui-pro.sh" 2>/dev/null || true
            cp -f "$MODULES_PATH/certificate.sh" "$BACKUP_DIR/certificate.sh" 2>/dev/null || true

            echo "Backup created."

            echo
            echo "Installing update..."

            UPDATE_FAILED=false

            cp "$TEMP_DIR/u-opti" "$INSTALL_PATH" || UPDATE_FAILED=true
            cp "$TEMP_DIR/common.sh" "$LIB_PATH/common.sh" || UPDATE_FAILED=true
            cp "$TEMP_DIR/VERSION" "$LIB_PATH/VERSION" || UPDATE_FAILED=true
            cp "$TEMP_DIR/system.sh" "$MODULES_PATH/system.sh" || UPDATE_FAILED=true
            cp "$TEMP_DIR/time.sh" "$MODULES_PATH/time.sh" || UPDATE_FAILED=true
            cp "$TEMP_DIR/swap.sh" "$MODULES_PATH/swap.sh" || UPDATE_FAILED=true
            cp "$TEMP_DIR/bbr.sh" "$MODULES_PATH/bbr.sh" || UPDATE_FAILED=true
            cp "$TEMP_DIR/storage.sh" "$MODULES_PATH/storage.sh" || UPDATE_FAILED=true
            cp "$TEMP_DIR/ssh.sh" "$MODULES_PATH/ssh.sh" || UPDATE_FAILED=true
            cp "$TEMP_DIR/firewall.sh" "$MODULES_PATH/firewall.sh" || UPDATE_FAILED=true
            cp "$TEMP_DIR/xui-pro.sh" "$MODULES_PATH/xui-pro.sh" || UPDATE_FAILED=true
            cp "$TEMP_DIR/certificate.sh" "$MODULES_PATH/certificate.sh" || UPDATE_FAILED=true

            if [ "$UPDATE_FAILED" = "true" ]; then

                echo
                echo "Update failed during installation."
                echo "Attempting to restore the previous version..."

                [ -f "$BACKUP_DIR/u-opti" ] && cp "$BACKUP_DIR/u-opti" "$INSTALL_PATH"
                [ -f "$BACKUP_DIR/common.sh" ] && cp "$BACKUP_DIR/common.sh" "$LIB_PATH/common.sh"
                [ -f "$BACKUP_DIR/VERSION" ] && cp "$BACKUP_DIR/VERSION" "$LIB_PATH/VERSION"

                [ -f "$BACKUP_DIR/system.sh" ] && cp "$BACKUP_DIR/system.sh" "$MODULES_PATH/system.sh"
                [ -f "$BACKUP_DIR/time.sh" ] && cp "$BACKUP_DIR/time.sh" "$MODULES_PATH/time.sh"
                [ -f "$BACKUP_DIR/swap.sh" ] && cp "$BACKUP_DIR/swap.sh" "$MODULES_PATH/swap.sh"
                [ -f "$BACKUP_DIR/bbr.sh" ] && cp "$BACKUP_DIR/bbr.sh" "$MODULES_PATH/bbr.sh"
                [ -f "$BACKUP_DIR/storage.sh" ] && cp "$BACKUP_DIR/storage.sh" "$MODULES_PATH/storage.sh"
                [ -f "$BACKUP_DIR/ssh.sh" ] && cp "$BACKUP_DIR/ssh.sh" "$MODULES_PATH/ssh.sh"
                [ -f "$BACKUP_DIR/firewall.sh" ] && cp "$BACKUP_DIR/firewall.sh" "$MODULES_PATH/firewall.sh"
                [ -f "$BACKUP_DIR/xui-pro.sh" ] && cp "$BACKUP_DIR/xui-pro.sh" "$MODULES_PATH/xui-pro.sh"
                [ -f "$BACKUP_DIR/certificate.sh" ] && cp "$BACKUP_DIR/certificate.sh" "$MODULES_PATH/certificate.sh"

                rm -rf "$BACKUP_DIR"
                rm -rf "$TEMP_DIR"

                echo
                echo "Previous version restored."
                echo

                read -rp "Press Enter to return..."
                continue
            fi

            chmod +x "$INSTALL_PATH"
            chmod +x "$LIB_PATH/common.sh"
            chmod +x "$MODULES_PATH/system.sh"
            chmod +x "$MODULES_PATH/time.sh"
            chmod +x "$MODULES_PATH/swap.sh"
            chmod +x "$MODULES_PATH/bbr.sh"
            chmod +x "$MODULES_PATH/storage.sh"
            chmod +x "$MODULES_PATH/ssh.sh"
            chmod +x "$MODULES_PATH/firewall.sh"
            chmod +x "$MODULES_PATH/xui-pro.sh"
            chmod +x "$MODULES_PATH/certificate.sh"

            rm -rf "$BACKUP_DIR"
            rm -rf "$TEMP_DIR"

            VERSION="$REMOTE_VERSION"

            echo
            echo "======================================"
            echo "          Update completed"
            echo "======================================"
            echo
            echo "Installed Version: $REMOTE_VERSION"
            echo
            echo "All U-OPTI modules were updated successfully."
            echo

            read -rp "Press Enter to return..."
            ;;

        8)
            clear

            echo "======================================"
            echo "          Uninstall U-OPTI"
            echo "======================================"
            echo

            read -rp "Are you sure you want to uninstall U-OPTI? [y/N]: " UNINSTALL_CONFIRM

            case "$UNINSTALL_CONFIRM" in

                y|Y|yes|YES)
                    rm -f "$INSTALL_PATH"
                    rm -rf "$LIB_PATH"

                    echo
                    echo "U-OPTI has been uninstalled."
                    exit 0
                    ;;

                *)
                    echo
                    echo "Uninstall cancelled."
                    sleep 2
                    ;;
            esac
            ;;

        0)
            exit 0
            ;;

        *)
            echo
            echo "Invalid selection!"
            sleep 2
            ;;
    esac
done
