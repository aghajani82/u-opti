#!/bin/bash

# U-OPTI requires root privileges.
if [ "$EUID" -ne 0 ]; then
    if ! command -v sudo >/dev/null 2>&1; then
        echo "Error: Root privileges are required, but sudo is not installed."
        exit 1
    fi

    exec sudo -E "$0" "$@"
fi

INSTALL_PATH="/usr/local/bin/u-opti"
LIB_PATH="/usr/local/lib/u-opti"
MODULES_PATH="$LIB_PATH/modules"
VERSION_FILE="$LIB_PATH/VERSION"

BRANCH="v0.13-dev"
BASE_URL="https://api.github.com/repos/aghajani82/u-opti/contents"
RAW_BASE_URL="https://raw.githubusercontent.com/aghajani82/u-opti/$BRANCH"

if [ -f "$VERSION_FILE" ]; then
    VERSION=$(tr -d '[:space:]' < "$VERSION_FILE")
fi

if [ -z "$VERSION" ]; then
    VERSION="0.12.0"
fi

source "$LIB_PATH/common.sh"
source "$MODULES_PATH/system.sh"
source "$MODULES_PATH/time.sh"
source "$MODULES_PATH/swap.sh"
source "$MODULES_PATH/bbr.sh"
source "$MODULES_PATH/storage.sh"
source "$MODULES_PATH/ssh.sh"
source "$MODULES_PATH/ssh-access.sh"
source "$MODULES_PATH/firewall.sh"
source "$MODULES_PATH/fail2ban.sh"
source "$MODULES_PATH/xui-pro.sh"
source "$MODULES_PATH/certificate.sh"
source "$MODULES_PATH/backup.sh"
source "$MODULES_PATH/docker.sh"
source "$MODULES_PATH/docker-3xui-nginx.sh"

while true; do
    clear

    echo "======================================"
    echo "              U-OPTI"
    echo "       Ubuntu Server Optimizer"
    echo "              v$VERSION"
    echo "======================================"
    echo
    echo "1) Update Server"
    echo "2) System Optimization"
    echo "3) Server Security"
    echo "4) X-UI PRO Management"
    echo "5) Certificate Management"
    echo "6) Backup & Restore"
    echo "7) Docker Management"
    echo "8) Update U-OPTI"
    echo "9) Uninstall U-OPTI"
    echo
    echo "0) Exit"
    echo

    read -rp "Please enter your selection [0-9]: " choice

    case "$choice" in

        1)
            clear

            echo "======================================"
            echo "           Updating Server"
            echo "======================================"
            echo

            apt update && apt upgrade -y

            echo
            echo "--------------------------------------"
            echo "Server update completed."
            echo

            read -rp "Press Enter to return to menu..."
            ;;

        2)
            while true; do
                clear

                echo "======================================"
                echo "        System Optimization"
                echo "======================================"
                echo
                echo "1) System Information"
                echo "2) Time & Date"
                echo "3) Swap Management"
                echo "4) BBR Management"
                echo "5) Storage Management"
                echo
                echo "0) Back"
                echo

                read -rp "Please enter your selection [0-5]: " opt_choice

                case "$opt_choice" in

                    1)
                        show_system_information
                        ;;

                    2)
                        show_time_menu
                        ;;

                    3)
                        show_swap_menu
                        ;;

                    4)
                        show_bbr_menu
                        ;;

                    5)
                        show_storage_menu
                        ;;

                    0)
                        break
                        ;;

                    *)
                        echo
                        echo "Invalid selection!"
                        sleep 2
                        ;;
                esac
            done
            ;;

        3)
            while true; do
                clear

                echo "======================================"
                echo "         Server Security"
                echo "======================================"
                echo
                echo "1) SSH Security"
                echo "2) Firewall Management"
                echo "3) Fail2Ban"
                echo
                echo "0) Back"
                echo

                read -rp "Please enter your selection [0-3]: " security_choice

                case "$security_choice" in

                    1)
                        show_ssh_menu
                        ;;

                    2)
                        show_firewall_menu
                        ;;

                    3)
                        show_fail2ban_menu
                        ;;

                    0)
                        break
                        ;;

                    *)
                        echo
                        echo "Invalid selection!"
                        sleep 2
                        ;;
                esac
            done
            ;;

        4)
            show_xui_pro_menu
            ;;

        5)
            show_certificate_menu
            ;;

        6)
            show_backup_menu
            ;;

        7)
            docker_management_menu
            ;;

        8)
            clear

            echo "======================================"
            echo "            Update U-OPTI"
            echo "======================================"
            echo

            if ! command -v curl >/dev/null 2>&1; then
                echo "Error: curl is not installed."
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            TEMP_DIR=$(mktemp -d)

            download_repo_file() {
                local REPO_PATH="$1"
                local DESTINATION="$2"

                curl -fsSL                     -H "Accept: application/vnd.github.raw+json"                     "${BASE_URL}/${REPO_PATH}?ref=${BRANCH}"                     -o "$DESTINATION"
            }

            cleanup_update_temp() {
                rm -rf "$TEMP_DIR"
            }

            update_failed_restore() {
                local RESTORE_OK=true
                local FILE

                echo
                echo "Update failed. Restoring the previous installation..."

                if [ -f "$BACKUP_DIR/u-opti" ]; then
                    if ! cp -f "$BACKUP_DIR/u-opti" "$INSTALL_PATH"; then
                        RESTORE_OK=false
                    fi
                fi

                if [ -f "$BACKUP_DIR/common.sh" ]; then
                    if ! cp -f "$BACKUP_DIR/common.sh" "$LIB_PATH/common.sh"; then
                        RESTORE_OK=false
                    fi
                fi

                if [ -f "$BACKUP_DIR/VERSION" ]; then
                    if ! cp -f "$BACKUP_DIR/VERSION" "$LIB_PATH/VERSION"; then
                        RESTORE_OK=false
                    fi
                fi

                for FILE in "${UPDATE_FILE_NAMES[@]}"; do
                    if [ -f "$BACKUP_DIR/$FILE" ]; then
                        if ! cp -f "$BACKUP_DIR/$FILE" "$UPDATE_DEST_DIR/$FILE"; then
                            RESTORE_OK=false
                        fi
                    fi
                done

                if [ "$RESTORE_OK" = "true" ]; then
                    echo "Previous installation restored successfully."
                else
                    echo "WARNING: Previous installation could not be fully restored."
                    echo "Backup retained at:"
                    echo "$BACKUP_DIR"
                    return 1
                fi

                return 0
            }

            UPDATE_FILE_NAMES=(
                "system.sh"
                "time.sh"
                "swap.sh"
                "bbr.sh"
                "storage.sh"
                "ssh.sh"
                "ssh-access.sh"
                "firewall.sh"
                "fail2ban.sh"
                "xui-pro.sh"
                "certificate.sh"
                "backup.sh"
                "docker.sh"
                "docker-3xui.sh"
                "docker-3xui-compat.sh"
                "docker-3xui-nginx.sh"
            )

            UPDATE_DEST_DIR="$MODULES_PATH"

            echo "Preparing update..."
            echo

            echo "Downloading VERSION..."

            if ! download_repo_file "VERSION" "$TEMP_DIR/VERSION"; then
                echo
                echo "Failed to download VERSION."
                cleanup_update_temp
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            REMOTE_VERSION=$(tr -d '[:space:]' < "$TEMP_DIR/VERSION")

            if [[ ! "$REMOTE_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
                echo
                echo "Invalid remote version: $REMOTE_VERSION"
                echo "Expected format: MAJOR.MINOR.PATCH"
                cleanup_update_temp
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            if [[ ! "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
                echo
                echo "Invalid installed version: $VERSION"
                echo "Update cancelled to protect the current installation."
                cleanup_update_temp
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo "Current Version : $VERSION"
            echo "Remote Version  : $REMOTE_VERSION"
            echo

            if [ "$REMOTE_VERSION" = "$VERSION" ]; then
                echo "U-OPTI is already up to date."
                echo "No files were changed."
                cleanup_update_temp
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            if [ "$(printf '%s\n' "$REMOTE_VERSION" "$VERSION" | sort -V | tail -n 1)" = "$VERSION" ]; then
                echo "Remote version is not newer than the installed version."
                echo "No files were changed."
                cleanup_update_temp
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo "A newer version is available."
            echo "Preparing to update from $VERSION to $REMOTE_VERSION."
            echo

            declare -A UPDATE_URLS=(
                ["u-opti"]="$BASE_URL/u-opti"
                ["common.sh"]="$BASE_URL/lib/common.sh"
                ["system.sh"]="$BASE_URL/modules/system.sh"
                ["time.sh"]="$BASE_URL/modules/time.sh"
                ["swap.sh"]="$BASE_URL/modules/swap.sh"
                ["bbr.sh"]="$BASE_URL/modules/bbr.sh"
                ["storage.sh"]="$BASE_URL/modules/storage.sh"
                ["ssh.sh"]="$BASE_URL/modules/ssh.sh"
                ["ssh-access.sh"]="$BASE_URL/modules/ssh-access.sh"
                ["firewall.sh"]="$BASE_URL/modules/firewall.sh"
                ["fail2ban.sh"]="$BASE_URL/modules/fail2ban.sh"
                ["xui-pro.sh"]="$BASE_URL/modules/xui-pro.sh"
                ["certificate.sh"]="$BASE_URL/modules/certificate.sh"
                ["backup.sh"]="$BASE_URL/modules/backup.sh"
                ["docker.sh"]="$BASE_URL/modules/docker.sh"
                ["docker-3xui.sh"]="$BASE_URL/modules/docker-3xui.sh"
                ["docker-3xui-compat.sh"]="$BASE_URL/modules/docker-3xui-compat.sh"
                ["docker-3xui-nginx.sh"]="$BASE_URL/modules/docker-3xui-nginx.sh"
            )

            declare -A UPDATE_TARGETS=(
                ["u-opti"]="$TEMP_DIR/u-opti"
                ["common.sh"]="$TEMP_DIR/common.sh"
                ["system.sh"]="$TEMP_DIR/system.sh"
                ["time.sh"]="$TEMP_DIR/time.sh"
                ["swap.sh"]="$TEMP_DIR/swap.sh"
                ["bbr.sh"]="$TEMP_DIR/bbr.sh"
                ["storage.sh"]="$TEMP_DIR/storage.sh"
                ["ssh.sh"]="$TEMP_DIR/ssh.sh"
                ["ssh-access.sh"]="$TEMP_DIR/ssh-access.sh"
                ["firewall.sh"]="$TEMP_DIR/firewall.sh"
                ["fail2ban.sh"]="$TEMP_DIR/fail2ban.sh"
                ["xui-pro.sh"]="$TEMP_DIR/xui-pro.sh"
                ["certificate.sh"]="$TEMP_DIR/certificate.sh"
                ["backup.sh"]="$TEMP_DIR/backup.sh"
                ["docker.sh"]="$TEMP_DIR/docker.sh"
                ["docker-3xui.sh"]="$TEMP_DIR/docker-3xui.sh"
                ["docker-3xui-compat.sh"]="$TEMP_DIR/docker-3xui-compat.sh"
                ["docker-3xui-nginx.sh"]="$TEMP_DIR/docker-3xui-nginx.sh"
            )

            echo "Downloading u-opti..."
            if ! download_repo_file "u-opti" "${UPDATE_TARGETS[u-opti]}"; then
                echo
                echo "Failed to download u-opti."
                cleanup_update_temp
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo "Downloading common.sh..."
            if ! download_repo_file "lib/common.sh" "${UPDATE_TARGETS[common.sh]}"; then
                echo
                echo "Failed to download common.sh."
                cleanup_update_temp
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            for FILE in "${UPDATE_FILE_NAMES[@]}"; do
                echo "Downloading $FILE..."

                case "$FILE" in
                    "docker-3xui-compat.sh")
                        REPO_PATH="modules/docker-3xui-compat.sh"
                        ;;
                    *)
                        REPO_PATH="modules/$FILE"
                        ;;
                esac

                if ! download_repo_file "$REPO_PATH" "${UPDATE_TARGETS[$FILE]}"; then
                    echo
                    echo "Failed to download $FILE."
                    cleanup_update_temp
                    echo
                    read -rp "Press Enter to return..."
                    continue 2
                fi
            done

            echo
            echo "Checking downloaded files..."

            REQUIRED_FILES=(
                "$TEMP_DIR/VERSION"
                "$TEMP_DIR/u-opti"
                "$TEMP_DIR/common.sh"
            )

            for FILE in "${UPDATE_FILE_NAMES[@]}"; do
                REQUIRED_FILES+=("$TEMP_DIR/$FILE")
            done

            UPDATE_FILES_OK=true

            for FILE in "${REQUIRED_FILES[@]}"; do
                if [ ! -s "$FILE" ]; then
                    echo
                    echo "Missing or empty file:"
                    echo "$FILE"
                    UPDATE_FILES_OK=false
                fi
            done

            if [ "$UPDATE_FILES_OK" != "true" ]; then
                echo
                echo "Update cancelled."
                echo "The installed version was not changed."
                cleanup_update_temp
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo "All required files are present."

            echo
            echo "Checking Bash syntax..."

            for FILE in "${REQUIRED_FILES[@]}"; do
                case "$FILE" in
                    "$TEMP_DIR/VERSION")
                        ;;
                    *)
                        if ! bash -n "$FILE"; then
                            echo
                            echo "Bash syntax check failed:"
                            echo "$FILE"
                            echo "Update cancelled."
                            cleanup_update_temp
                            echo
                            read -rp "Press Enter to return..."
                            continue 2
                        fi
                        ;;
                esac
            done

            echo "Bash syntax check passed."

            echo
            echo "Creating backup of current installation..."

            BACKUP_DIR=$(mktemp -d)

            BACKUP_FILES=(
                "system.sh"
                "time.sh"
                "swap.sh"
                "bbr.sh"
                "storage.sh"
                "ssh.sh"
                "ssh-access.sh"
                "firewall.sh"
                "fail2ban.sh"
                "xui-pro.sh"
                "certificate.sh"
                "backup.sh"
                "docker.sh"
                "docker-3xui.sh"
                "docker-3xui-compat.sh"
                "docker-3xui-nginx.sh"
            )

            BACKUP_OK=true

            if [ -f "$INSTALL_PATH" ]; then
                cp -f "$INSTALL_PATH" "$BACKUP_DIR/u-opti" || BACKUP_OK=false
            else
                echo "ERROR: Installed U-OPTI executable was not found."
                BACKUP_OK=false
            fi

            if [ -f "$LIB_PATH/common.sh" ]; then
                cp -f "$LIB_PATH/common.sh" "$BACKUP_DIR/common.sh" || BACKUP_OK=false
            else
                echo "ERROR: Installed common.sh was not found."
                BACKUP_OK=false
            fi

            if [ -f "$LIB_PATH/VERSION" ]; then
                cp -f "$LIB_PATH/VERSION" "$BACKUP_DIR/VERSION" || BACKUP_OK=false
            else
                echo "ERROR: Installed VERSION file was not found."
                BACKUP_OK=false
            fi

            for FILE in "${BACKUP_FILES[@]}"; do
                if [ -f "$MODULES_PATH/$FILE" ]; then
                    cp -f "$MODULES_PATH/$FILE" "$BACKUP_DIR/$FILE" || BACKUP_OK=false
                else
                    echo "ERROR: Installed module was not found: $FILE"
                    BACKUP_OK=false
                fi
            done

            if [ ! -f "$BACKUP_DIR/u-opti" ] || \
               [ ! -f "$BACKUP_DIR/common.sh" ] || \
               [ ! -f "$BACKUP_DIR/VERSION" ] || \
               [ "$(find "$BACKUP_DIR" -maxdepth 1 -type f | wc -l)" -ne 19 ]; then
                BACKUP_OK=false
            fi

            if [ "$BACKUP_OK" != "true" ]; then
                echo
                echo "Backup creation failed or is incomplete."
                echo "Update cancelled. No installed files were changed."
                echo "Temporary backup retained at:"
                echo "$BACKUP_DIR"
                cleanup_update_temp
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo "Backup created successfully."

            echo
            echo "Installing update..."

            UPDATE_FAILED=false

            if ! cp "$TEMP_DIR/u-opti" "$INSTALL_PATH"; then
                UPDATE_FAILED=true
            fi

            if ! cp "$TEMP_DIR/common.sh" "$LIB_PATH/common.sh"; then
                UPDATE_FAILED=true
            fi

            if ! cp "$TEMP_DIR/VERSION" "$LIB_PATH/VERSION"; then
                UPDATE_FAILED=true
            fi

            for FILE in "${UPDATE_FILE_NAMES[@]}"; do
                if ! cp "${UPDATE_TARGETS[$FILE]}" "$MODULES_PATH/$FILE"; then
                    UPDATE_FAILED=true
                fi
            done

            if [ "$UPDATE_FAILED" = "false" ]; then
                if ! chmod +x "$INSTALL_PATH" || \
                   ! chmod +x "$LIB_PATH/common.sh"; then
                    UPDATE_FAILED=true
                fi

                for FILE in "${UPDATE_FILE_NAMES[@]}"; do
                    if ! chmod +x "$MODULES_PATH/$FILE"; then
                        UPDATE_FAILED=true
                    fi
                done
            fi

            if [ "$UPDATE_FAILED" = "false" ]; then
                echo
                echo "Verifying installed files..."

                if ! cmp -s "$TEMP_DIR/u-opti" "$INSTALL_PATH"; then
                    UPDATE_FAILED=true
                fi

                if ! cmp -s "$TEMP_DIR/common.sh" "$LIB_PATH/common.sh"; then
                    UPDATE_FAILED=true
                fi

                if ! cmp -s "$TEMP_DIR/VERSION" "$LIB_PATH/VERSION"; then
                    UPDATE_FAILED=true
                fi

                for FILE in "${UPDATE_FILE_NAMES[@]}"; do
                    if ! cmp -s "${UPDATE_TARGETS[$FILE]}" "$MODULES_PATH/$FILE"; then
                        UPDATE_FAILED=true
                        break
                    fi
                done
            fi

            if [ "$UPDATE_FAILED" = "true" ]; then
                echo
                echo "Update failed during installation or verification."

                if ! update_failed_restore; then
                    echo "WARNING: Restore routine returned an error."
                fi

                if [ -f "$BACKUP_DIR/u-opti" ] && \
                   [ -f "$BACKUP_DIR/common.sh" ] && \
                   [ -f "$BACKUP_DIR/VERSION" ]; then
                    echo
                    echo "Previous version restore check completed."
                fi

                rm -rf "$BACKUP_DIR"
                cleanup_update_temp

                echo
                read -rp "Press Enter to return..."
                continue
            fi

            VERSION="$REMOTE_VERSION"

            if [ "$(tr -d '[:space:]' < "$LIB_PATH/VERSION")" != "$REMOTE_VERSION" ]; then
                echo
                echo "ERROR: Installed VERSION verification failed."
                echo "The update was not considered successful."
                echo "Attempting to restore the previous version..."

                if ! update_failed_restore; then
                    echo "WARNING: Restore routine returned an error."
                fi

                cleanup_update_temp
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            rm -rf "$BACKUP_DIR"
            cleanup_update_temp

            echo
            echo "======================================"
            echo "          Update completed"
            echo "======================================"
            echo
            echo "Installed Version: $REMOTE_VERSION"
            echo
            echo "All U-OPTI modules were updated successfully."
            echo
            echo "Restarting U-OPTI with the new version..."
            sleep 1
            exec "$INSTALL_PATH"
            ;;

        9)
            clear

            echo "======================================"
            echo "          Uninstall U-OPTI"
            echo "======================================"
            echo

            echo "U-OPTI will remove only its own installation files:"
            echo "  - $INSTALL_PATH"
            echo "  - $LIB_PATH"
            echo

            echo "The following are NOT removed by U-OPTI:"
            echo "  - Nginx"
            echo "  - Certbot / Let's Encrypt certificates"
            echo "  - 3x-UI / Xray"
            echo "  - Docker"
            echo "  - Your server data and other services"
            echo

            echo "U-OPTI backup data under /etc/u-opti is retained."
            echo

            read -rp "Type UNINSTALL to continue: " UNINSTALL_CONFIRM

            if [ "$UNINSTALL_CONFIRM" != "UNINSTALL" ]; then
                echo
                echo "Uninstall cancelled."
                sleep 2
                continue
            fi

            echo
            echo "Creating a final U-OPTI safety backup..."

            FINAL_BACKUP_DIR=""

            if [ -d "/etc/u-opti" ]; then
                FINAL_BACKUP_DIR="/etc/u-opti/backups/$(date '+%Y%m%d-%H%M%S-%N')-pre-uninstall"
                mkdir -p "$FINAL_BACKUP_DIR" || FINAL_BACKUP_DIR=""

                if [ -n "$FINAL_BACKUP_DIR" ]; then
                    if ! tar -C / --exclude="etc/u-opti/backups" -czf "$FINAL_BACKUP_DIR/u-opti-installation.tar.gz" \
                        "usr/local/bin/u-opti" \
                        "usr/local/lib/u-opti" \
                        "etc/u-opti" 2>/dev/null; then

                        rm -rf "$FINAL_BACKUP_DIR"
                        FINAL_BACKUP_DIR=""
                    fi
                fi
            fi

            if [ -n "$FINAL_BACKUP_DIR" ] && \
               [ -f "$FINAL_BACKUP_DIR/u-opti-installation.tar.gz" ]; then

                chmod 700 "$FINAL_BACKUP_DIR"
                chmod 600 "$FINAL_BACKUP_DIR/u-opti-installation.tar.gz"

                echo "Safety backup created:"
                echo "$FINAL_BACKUP_DIR/u-opti-installation.tar.gz"
            else
                echo "WARNING: Final safety backup could not be created."
                echo "U-OPTI was NOT uninstalled."
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            rm -f "$INSTALL_PATH"
            rm -rf "$LIB_PATH"

            if [ -e "$INSTALL_PATH" ] || [ -e "$LIB_PATH" ]; then
                echo
                echo "ERROR: U-OPTI files could not be fully removed."
                echo "Safety backup retained at:"
                echo "$FINAL_BACKUP_DIR/u-opti-installation.tar.gz"
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo
            echo "======================================"
            echo "       U-OPTI Uninstalled Safely"
            echo "======================================"
            echo

            echo "Removed:"
            echo "  - $INSTALL_PATH"
            echo "  - $LIB_PATH"
            echo

            echo "Retained:"
            echo "  - /etc/u-opti and its backups"
            echo "  - Nginx / Certbot"
            echo "  - 3x-UI / Xray"
            echo "  - Docker and other services"
            echo

            echo "Safety backup retained at:"
            echo "$FINAL_BACKUP_DIR/u-opti-installation.tar.gz"
            echo

            exit 0
            ;;

        0)
            exit 0
            ;;

        *)
            echo
            echo "Invalid selection!"
            sleep 2
            ;;
    esac
done
