                ["smite-foreign-gateway.sh"]="$TEMP_DIR/smite-foreign-gateway.sh"
                ["docker-3xui-instance.sh"]="$TEMP_DIR/docker-3xui-instance.sh"
                ["docker-3xui-certificate-multi.sh"]="$TEMP_DIR/docker-3xui-certificate-multi.sh"
                ["docker-3xui.sh"]="$TEMP_DIR/docker-3xui.sh"
                ["docker-3xui-compat.sh"]="$TEMP_DIR/docker-3xui-compat.sh"
                ["docker-3xui-nginx.sh"]="$TEMP_DIR/docker-3xui-nginx.sh"
                ["docker-3xui-xhttp-guard.py"]="$TEMP_DIR/docker-3xui-xhttp-guard.py"
                ["fakesite.sh"]="$TEMP_DIR/fakesite.sh"
            )

            echo "Downloading u-opti..."
            if ! download_repo_file "u-opti" "${UPDATE_TARGETS[u-opti]}"; then
                echo
                echo "Failed to download u-opti."
                cleanup_update_temp
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo "Downloading common.sh..."
            if ! download_repo_file "lib/common.sh" "${UPDATE_TARGETS[common.sh]}"; then
                echo
                echo "Failed to download common.sh."
                cleanup_update_temp
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            for FILE in "${UPDATE_FILE_NAMES[@]}"; do
                echo "Downloading $FILE..."

                case "$FILE" in
                    "docker-3xui-compat.sh")
                        REPO_PATH="modules/docker-3xui-compat.sh"
                        ;;
                    *)
                        REPO_PATH="modules/$FILE"
                        ;;
                esac

                if ! download_repo_file "$REPO_PATH" "${UPDATE_TARGETS[$FILE]}"; then
                    echo
                    echo "Failed to download $FILE."
                    cleanup_update_temp
                    echo
                    read -rp "Press Enter to return..."
                    continue 2
                fi
            done

            echo
            echo "Checking downloaded files..."

            REQUIRED_FILES=(
                "$TEMP_DIR/VERSION"
                "$TEMP_DIR/u-opti"
                "$TEMP_DIR/common.sh"
            )

            for FILE in "${UPDATE_FILE_NAMES[@]}"; do
                REQUIRED_FILES+=("$TEMP_DIR/$FILE")
            done

            UPDATE_FILES_OK=true

            for FILE in "${REQUIRED_FILES[@]}"; do
                if [ ! -s "$FILE" ]; then
                    echo
                    echo "Missing or empty file:"
                    echo "$FILE"
                    UPDATE_FILES_OK=false
                fi
            done

            if [ "$UPDATE_FILES_OK" != "true" ]; then
                echo
                echo "Update cancelled."
                echo "The installed version was not changed."
                cleanup_update_temp
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo "All required files are present."

            if ! grep -q 'echo "6) Hostname Management"' "$TEMP_DIR/u-opti" || \
               ! grep -q 'show_hostname_menu' "$TEMP_DIR/u-opti" || \
               ! grep -q 'show_hostname_menu()' "$TEMP_DIR/system.sh" || \
               ! grep -q 'echo "5) Smite Management"' "$TEMP_DIR/docker.sh" || \
               ! grep -q 'docker_smite_management_menu' "$TEMP_DIR/docker.sh" || \
               ! grep -q 'show_smite_menu()' "$TEMP_DIR/smite.sh" || \
               ! grep -q 'show_smite_install_menu()' "$TEMP_DIR/smite-install.sh" || \
               ! grep -q 'show_smite_gateway_menu()' "$TEMP_DIR/smite-gateway.sh" || \
               ! grep -q 'smite_frp_wizard_menu()' "$TEMP_DIR/smite-frp-wizard.sh" || \
               ! grep -q 'def render(' "$TEMP_DIR/smite-frp-xhttp-paths.py" || \
               ! grep -q 'def inspection(' "$TEMP_DIR/smite-frp-rc2-guided-publish.py" || \
               ! grep -q 'smite_bh_management_menu()' "$TEMP_DIR/smite-backhaul-management.sh" || \
               ! grep -q 'smite_tw_menu()' "$TEMP_DIR/smite-tunnel-wizard.sh" || \
               ! grep -q 'twcc_menu()' "$TEMP_DIR/smite-tunnel-control-center.sh" || \
               ! grep -q 'show_smite_foreign_gateway_menu()' "$TEMP_DIR/smite-foreign-gateway.sh" || \
               ! grep -q 'docker_3xui_multi_certificate_menu()' "$TEMP_DIR/docker-3xui-certificate-multi.sh"; then
                echo
                echo "ERROR: Downloaded files failed feature verification."
                echo "The downloaded U-OPTI files are inconsistent or stale."
                echo "Update cancelled and no installed files were changed."
                cleanup_update_temp
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo "Feature verification passed."

            echo
            echo "Checking Bash syntax..."

            for FILE in "${REQUIRED_FILES[@]}"; do
                case "$FILE" in
                    "$TEMP_DIR/VERSION")
                        ;;
                    # Extensionless root-only route helper is Python as well.
                    "$TEMP_DIR/"*.py|"$TEMP_DIR/smite-xhttp-nginx-route")
                        if ! python3 -m py_compile "$FILE"; then
                            echo "Python syntax check failed: $FILE"
                            cleanup_update_temp
                            read -rp "Press Enter to return..."
                            continue 2
                        fi
                        ;;
                    *)
                        if ! bash -n "$FILE"; then
                            echo
                            echo "Bash syntax check failed:"
                            echo "$FILE"
                            echo "Update cancelled."
                            cleanup_update_temp
                            echo
                            read -rp "Press Enter to return..."
                            continue 2
                        fi
                        ;;
                esac
            done

            echo "Bash syntax check passed."

            if [ "$SAME_VERSION_UPDATE" = "true" ]; then
                echo
                echo "Comparing remote files with the installed version..."

                SAME_VERSION_CHANGED=false

                if ! cmp -s "$TEMP_DIR/u-opti" "$INSTALL_PATH"; then
                    SAME_VERSION_CHANGED=true
                fi

                if ! cmp -s "$TEMP_DIR/common.sh" "$LIB_PATH/common.sh"; then
                    SAME_VERSION_CHANGED=true
                fi

                if ! cmp -s "$TEMP_DIR/VERSION" "$LIB_PATH/VERSION"; then
                    SAME_VERSION_CHANGED=true
                fi

                for FILE in "${UPDATE_FILE_NAMES[@]}"; do
                    if [ ! -f "$MODULES_PATH/$FILE" ] ||
                       ! cmp -s "${UPDATE_TARGETS[$FILE]}" "$MODULES_PATH/$FILE"; then
                        SAME_VERSION_CHANGED=true
                        break
                    fi
                done

                if [ "$SAME_VERSION_CHANGED" = "false" ]; then
                    echo "U-OPTI is already up to date."
                    echo "No files were changed."
                    cleanup_update_temp
                    echo
                    read -rp "Press Enter to return..."
                    continue
                fi

                echo "Changes detected in the same version."
                echo "Proceeding with the update."
                echo
            fi

            echo
            echo "Creating backup of current installation..."

            # Durable on-disk backup: /tmp is not reliable across reboots.
            BACKUP_DIR=$(mktemp -d "$LIB_PATH/.uopti-backup-XXXXXXXX") || {
                echo "HOLD: Could not reserve persistent recovery directory."
                cleanup_update_temp
                read -rp "Press Enter to return..."
                continue
            }

            BACKUP_FILES=(
                "system.sh"
                "time.sh"
                "swap.sh"
                "bbr.sh"
                "storage.sh"
                "ssh.sh"
                "ssh-access.sh"
                "firewall.sh"
                "fail2ban.sh"
                "xui-pro.sh"
                "certificate.sh"
                "backup.sh"
                "docker.sh"
                "smite.sh"
                "smite-node-local-bind.py"
                "smite-node-pairing.py"
                "smite-node-auth-candidate.py"
                "smite-node-replay-mount-admission.py"
                "smite-auth-image-overlay-audit.py"
                "smite-stage11-overlay-review.py"
                "smite-stage12-nginx-hmac-plan.py"
                "smite-stage19-pairing-443-plan.py"
                "smite-stage13-preflight.py"
                "smite-panel-auth-overlay.py"
                "smite-stage15-bundle-verify.py"
                "smite-clean-image-pair.py"
                "smite-registry-pair-admission.py"
                "smite-field-trial-candidate.json"
                "u-opti-update-transaction.py"
                "smite-foreign-gateway-signed-check.py"
                "smite-node-pairing-wizard.sh"
                "smite-install.sh"
                "smite-clean-rc-preflight.sh"
                "smite-xhttp-nginx-route"
                "smite_xhttp_nginx_plan.py"
                "smite-rc5-xhttp-root-broker.py"
                "smite-rc5-xhttp-broker-provision.py"
                "smite-rc5-xhttp-broker-compose.py"
                "smite-rc5-xhttp-sanaei-mount.py"
                "smite-rc5-xhttp-nonce-ledger.py"
                "smite-rc5-xhttp-signed-intent.py"
                "smite-rc5-xhttp-bridge-install.py"
                "smite-rc5-xhttp-bridge-admission.py"
                "smite-gateway.sh"
                "smite-frp-xhttp.sh"
                "smite-frp-xhttp-paths.py"
                "smite-frp-rc2-guided-publish.py"
                "smite-profile-first.py"
                "smite-profile-first-menu.sh"
                "smite-frp-wizard.sh"
                "smite-backhaul-management.sh"
                "smite-clean-ir-resume.sh"
                "smite-tunnel-wizard.sh"
                "smite-tunnel-control-center.sh"
                "smite-managed-backhaul.py"
                "smite-managed-frp.py"
                "smite-managed-frp-transaction.py"
                "smite-managed-frp-control.py"
                "smite-managed-frp-menu.sh"
                "smite-managed-backhaul-control.py"
                "smite-managed-backhaul-menu.sh"
                "smite-managed-backhaul-host-gate.py"
                "smite-managed-backhaul-host-executor.py"
                "smite-managed-engine-host-admission.py"
                "smite-managed-engine-host-plan.py"
                "smite-managed-backhaul-pair-review.py"
                "smite-managed-backhaul-lifecycle.py"
                "smite-managed-backhaul-transaction.py"
                "smite-backhaul-sidecar.py"
                "smite-backhaul-sidecar-readiness.py"
                "smite-backhaul-sidecar-guided-prep.py"
                "smite-backhaul-sidecar-guided-trial.py"
                "smite-backhaul-sidecar-ssh-pair.py"
                "smite-backhaul-sidecar-paste-pair.py"
                "smite-backhaul-sidecar-admission.py"
                "smite-backhaul-sidecar-token.py"
                "smite-backhaul-sidecar-live-trial.py"
                "smite-backhaul-sidecar-reconcile.py"
                "smite-backhaul-rebuild-gate.sh"
                "smite-backhaul-sidecar-nginx-plan.py"
                "smite-backhaul-standard.sh"
                "smite-backhaul-spec.py"
                "smite-backhaul-node-patch.py"
                "smite-backhaul-panel-patch.py"
                "smite-foreign-gateway.sh"
                "docker-3xui-instance.sh"
                "docker-3xui-certificate-multi.sh"
                "docker-3xui.sh"
                "docker-3xui-compat.sh"
                "docker-3xui-nginx.sh"
                "docker-3xui-xhttp-guard.py"
                "fakesite.sh"
            )

            BACKUP_OK=true

            if [ -f "$INSTALL_PATH" ]; then
                cp -f "$INSTALL_PATH" "$BACKUP_DIR/u-opti" || BACKUP_OK=false
            else
                echo "ERROR: Installed U-OPTI executable was not found."
                BACKUP_OK=false
            fi

            if [ -f "$LIB_PATH/common.sh" ]; then
                cp -f "$LIB_PATH/common.sh" "$BACKUP_DIR/common.sh" || BACKUP_OK=false
            else
                echo "ERROR: Installed common.sh was not found."
                BACKUP_OK=false
            fi

            if [ -f "$LIB_PATH/VERSION" ]; then
                cp -f "$LIB_PATH/VERSION" "$BACKUP_DIR/VERSION" || BACKUP_OK=false
            else
                echo "ERROR: Installed VERSION file was not found."
                BACKUP_OK=false
            fi

            # INSTALL_REF is now a journaled installed target, not a
            # best-effort metadata write after the update has committed.
            if [ -L "$LIB_PATH/INSTALL_REF" ]; then
                echo "HOLD: Unsafe persisted update-channel symlink."
                BACKUP_OK=false
            elif [ -f "$LIB_PATH/INSTALL_REF" ]; then
                if ! cp -f -- "$LIB_PATH/INSTALL_REF" "$BACKUP_DIR/INSTALL_REF" ||
                   ! chmod 0600 "$BACKUP_DIR/INSTALL_REF"; then
                    BACKUP_OK=false
                fi
            elif [ ! -e "$LIB_PATH/INSTALL_REF" ]; then
                if ! : > "$BACKUP_DIR/.INSTALL_REF-was-missing" ||
                   ! chmod 0600 "$BACKUP_DIR/.INSTALL_REF-was-missing"; then
                    BACKUP_OK=false
                fi
            else
                BACKUP_OK=false
            fi

            for FILE in "${BACKUP_FILES[@]}"; do
                if [ -f "$MODULES_PATH/$FILE" ]; then
                    cp -f "$MODULES_PATH/$FILE" "$BACKUP_DIR/$FILE" || BACKUP_OK=false
                elif [[ "$FILE" = "smite.sh" || "$FILE" = "smite-install.sh" || "$FILE" = "smite-gateway.sh" || "$FILE" = "smite-foreign-gateway.sh" || "$FILE" = "smite-registry-pair-admission.py" || "$FILE" = "smite-field-trial-candidate.json" || "$FILE" = "docker-3xui-xhttp-guard.py" || "$FILE" = "docker-3xui-certificate-multi.sh" || "$FILE" = "smite-clean-ir-resume.sh" || "$FILE" = "smite-clean-rc-preflight.sh" || "$FILE" = smite-backhaul-* || "$FILE" = smite-frp-* || "$FILE" = "u-opti-update-transaction.py" ]]; then
                    : > "$BACKUP_DIR/.${FILE}-was-missing"
                else
                    echo "ERROR: Installed module was not found: $FILE"
                    BACKUP_OK=false
                fi
            done

            if [ ! -f "$BACKUP_DIR/u-opti" ] || \
               [ ! -f "$BACKUP_DIR/common.sh" ] || \
               [ ! -f "$BACKUP_DIR/VERSION" ] || \
               [ "$(find "$BACKUP_DIR" -maxdepth 1 -type f | wc -l)" -ne "$((4 + ${#BACKUP_FILES[@]}))" ]; then
                BACKUP_OK=false
            fi

            if [ "$BACKUP_OK" != "true" ]; then
                echo
                echo "Backup creation failed or is incomplete."
                echo "Update cancelled. No installed files were changed."
                echo "Temporary backup retained at:"
                echo "$BACKUP_DIR"
                cleanup_update_temp
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo "Backup created successfully."

            echo
            echo "Installing update using recoverable, atomic-per-file journal..."

            # This helper is part of the downloaded, syntax-checked SAME SHA.
            # It writes a durable journal + private persistent recovery copy
            # before changing any installed bytes. Crash -> startup recovery.
            UPDATE_FAILED=false
            if ! python3 -B "$TEMP_DIR/u-opti-update-transaction.py" apply \
                    "$TEMP_DIR" "$BACKUP_DIR" --source-ref "$BRANCH" "${UPDATE_FILE_NAMES[@]}"; then
                UPDATE_FAILED=true
            fi

            if [ "$UPDATE_FAILED" = "true" ]; then
                echo
                echo "Update failed during installation or verification."
                RESTORE_OK=false

                if [ -e "$LIB_PATH/.uopti-update-pending" ] || [ -L "$LIB_PATH/.uopti-update-pending" ]; then
                    # When an atomic transaction was armed, restore only with
                    # the journal's unchanged, private helper. The old Bash
                    # restore knows nothing about hashes or power-loss state.
                    if [ -f "$LIB_PATH/.uopti-update-pending/rescue.py" ] &&
                       [ ! -L "$LIB_PATH/.uopti-update-pending/rescue.py" ] &&
                       python3 -B "$LIB_PATH/.uopti-update-pending/rescue.py" recover; then
                        RESTORE_OK=true
                    fi
                elif update_failed_restore; then
                    # Legacy fail-before-arm fallback: no transaction wrote any
                    # installed bytes, but preserve the original restore check.
                    RESTORE_OK=true
                fi

                if [ "$RESTORE_OK" = "true" ]; then
                    echo "Previous installation restored successfully."
                    rm -rf -- "$BACKUP_DIR"
                else
                    echo "CRITICAL: Automatic restore was incomplete."
                    echo "Do not retry the update until the previous state is reviewed."
                    echo "Recovery backup retained at:"
                    echo "$BACKUP_DIR"
                fi

                cleanup_update_temp

                echo
                read -rp "Press Enter to return..."
                continue
            fi

            VERSION="$REMOTE_VERSION"

            if [ "$(tr -d '[:space:]' < "$LIB_PATH/VERSION")" != "$REMOTE_VERSION" ]; then
                echo
                echo "ERROR: Installed VERSION verification failed."
                echo "The update was not considered successful."
                echo "Attempting to restore the previous version..."

                if ! update_failed_restore; then
                    echo "WARNING: Restore routine returned an error."
                fi

                cleanup_update_temp
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            rm -rf "$BACKUP_DIR"
            cleanup_update_temp

            echo
            echo "======================================"
            echo "          Update completed"
            echo "======================================"
            echo
            echo "Installed Version: $REMOTE_VERSION"
            echo
            echo "All U-OPTI modules were updated successfully."
            echo
            echo "Restarting U-OPTI with the new version..."
            sleep 1
            exec "$INSTALL_PATH"
            ;;

        9)
            clear

            echo "======================================"
            echo "          Uninstall U-OPTI"
            echo "======================================"
            echo

            echo "U-OPTI will remove only its own installation files:"
            echo "  - $INSTALL_PATH"
            echo "  - $LIB_PATH"
            echo

            echo "The following are NOT removed by U-OPTI:"
            echo "  - Nginx"
            echo "  - Certbot / Let's Encrypt certificates"
            echo "  - 3x-UI / Xray"
            echo "  - Docker"
            echo "  - Your server data and other services"
            echo

            echo "U-OPTI backup data under /etc/u-opti is retained."
            echo

            read -rp "Type UNINSTALL to continue: " UNINSTALL_CONFIRM

            if [ "$UNINSTALL_CONFIRM" != "UNINSTALL" ]; then
                echo
                echo "Uninstall cancelled."
                sleep 2
                continue
            fi

                        echo
            echo "Creating a final U-OPTI safety backup..."

            FINAL_BACKUP_DIR=""
            BACKUP_OK=false
            BACKUP_SKIPPED=false

            if [ -d "/etc/u-opti" ]; then
                FINAL_BACKUP_DIR="/etc/u-opti/backups/$(date '+%Y%m%d-%H%M%S-%N')-pre-uninstall"

                if mkdir -p "$FINAL_BACKUP_DIR"; then
                    # Only include paths that actually exist.
                    BACKUP_SOURCES=()
                    [ -e "/usr/local/bin/u-opti" ] && BACKUP_SOURCES+=("usr/local/bin/u-opti")
                    [ -e "/usr/local/lib/u-opti" ] && BACKUP_SOURCES+=("usr/local/lib/u-opti")
                    [ -e "/etc/u-opti" ]           && BACKUP_SOURCES+=("etc/u-opti")

                    if [ "${#BACKUP_SOURCES[@]}" -gt 0 ]; then
                        if tar -C / \
                            --exclude="etc/u-opti/backups" \
                            -czf "$FINAL_BACKUP_DIR/u-opti-installation.tar.gz" \
                            "${BACKUP_SOURCES[@]}"; then
                            BACKUP_OK=true
                        fi
                    fi
                fi

                if [ "$BACKUP_OK" != "true" ]; then
                    # Real failure when /etc/u-opti exists.
                    [ -n "$FINAL_BACKUP_DIR" ] && rm -rf "$FINAL_BACKUP_DIR"
                    FINAL_BACKUP_DIR=""
                fi
            else
                # /etc/u-opti does not exist.
                # There is nothing to preserve under /etc/u-opti, so a
                # safety backup is not required. The uninstall can proceed.
                BACKUP_SKIPPED=true
            fi

            if [ "$BACKUP_SKIPPED" = "true" ]; then
                echo "No U-OPTI configuration directory (/etc/u-opti) was found."
                echo "No safety backup is required. Continuing with uninstall..."
            elif [ "$BACKUP_OK" = "true" ] && \
                 [ -n "$FINAL_BACKUP_DIR" ] && \
                 [ -f "$FINAL_BACKUP_DIR/u-opti-installation.tar.gz" ]; then

                chmod 700 "$FINAL_BACKUP_DIR"
                chmod 600 "$FINAL_BACKUP_DIR/u-opti-installation.tar.gz"

                echo "Safety backup created:"
                echo "$FINAL_BACKUP_DIR/u-opti-installation.tar.gz"
            else
                echo "WARNING: Final safety backup could not be created."
                echo "U-OPTI was NOT uninstalled."
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            rm -f "$INSTALL_PATH"
            rm -rf "$LIB_PATH"

            if [ -e "$INSTALL_PATH" ] || [ -e "$LIB_PATH" ]; then
                echo
                echo "ERROR: U-OPTI files could not be fully removed."
                echo "Safety backup retained at:"
                echo "$FINAL_BACKUP_DIR/u-opti-installation.tar.gz"
                echo
                read -rp "Press Enter to return..."
                continue
            fi

            echo
            echo "======================================"
            echo "       U-OPTI Uninstalled Safely"
            echo "======================================"
            echo

            echo "Removed:"
            echo "  - $INSTALL_PATH"
            echo "  - $LIB_PATH"
            echo

            echo "Retained:"
            if [ -d "/etc/u-opti" ]; then
                echo "  - /etc/u-opti and its backups"
            else
                echo "  - Existing server data and other services"
            fi
            echo "  - Nginx / Certbot"
            echo "  - 3x-UI / Xray"
            echo "  - Docker and other services"
            echo

            if [ "$BACKUP_SKIPPED" = "true" ]; then
                echo "No safety backup was created because /etc/u-opti did not exist."
            elif [ "$BACKUP_OK" = "true" ] && [ -n "$FINAL_BACKUP_DIR" ] && \
                 [ -f "$FINAL_BACKUP_DIR/u-opti-installation.tar.gz" ]; then
                echo "Safety backup retained at:"
                echo "$FINAL_BACKUP_DIR/u-opti-installation.tar.gz"
            fi
            echo

            exit 0
            ;;

        0)
            exit 0
            ;;

        *)
            echo
            echo "Invalid selection!"
            sleep 2
            ;;
    esac
done
