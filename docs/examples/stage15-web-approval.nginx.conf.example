# Stage15 Independent Web Approval (example ONLY; DO NOT INSTALL)

# IR currently owns public 443 with nginx STREAM + ssl_preread SNI dispatch.
# A new HTTP "listen 443 ssl" would conflict with the live STREAM socket.
# This example intentionally uses an INVALID port placeholder until the
# operator has read-only-audited the existing STREAM map, default route,
# backend assignment and selected an unused 127.0.0.1-only TLS port.
#
# Once separately approved, add ONLY the exact approval SNI mapping to
# the existing reviewed STREAM dispatcher. Never add a second public
# 443 listener, change the default SNI route, or modify FRP tunnel targets.
# A dedicated hostname and trusted LE certificate require separate approval.
# Domain, local port, and certificate paths remain placeholders: nginx -t
# MUST FAIL before review/substitution. Never install this example as-is.
# Root-only web service stays behind its protected Unix domain socket.
server {
    listen 127.0.0.1:REVIEW_ONLY_TLS_LOOPBACK_PORT ssl;
    server_name REVIEW_HOSTNAME_REQUIRES_OPERATOR_APPROVAL;
    ssl_certificate     /etc/letsencrypt/live/REVIEW_HOSTNAME_REQUIRES_OPERATOR_APPROVAL/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/REVIEW_HOSTNAME_REQUIRES_OPERATOR_APPROVAL/privkey.pem;

    client_max_body_size 16k;
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://unix:/run/u-opti-smite-review/web-approval.sock:;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Never include a global proxy_set_header X-Forwarded-* here:
        # the Root-only UDS review server rejects these headers entirely.
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_pass_request_headers on;
        proxy_buffering off;
        proxy_read_timeout 15s;
        proxy_connect_timeout 2s;
    }
}
